# کپی کن به .env و مقادیر را پر کن
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_CHAT_ID=-1001234567890
# DRY_RUN=1 → پیام‌ها فقط در کنسول/لاگ (بدون ارسال واقعی). برای ارسال واقعی 0 بگذار
DRY_RUN=1
# (اختیاری) دایرکتوری داده جدا برای تست/شبیه‌سازی
# PS_DATA_DIR=/path/to/data

# ---- گاردهای پرتفویی W2 (اختیاری — پیش‌فرض‌ها توصیه‌شده) ----
# MAX_OPEN_TRADES=5        # سقف سراسری پوزیشن باز
# MAX_DAILY_LOSS_R=3.0     # مدار قطع روزانه بعد از -3R ضرر تجمعی
# PORTFOLIO_GUARDS=1       # 0 فقط برای شبیه‌سازی/پژوهش؛ در تولید همیشه 1

# ---- کشف ترند + مشورت AI برای F1 (از v3.4.0) ----
# ترند چندمنبعی (CoinGecko+Binance+F&G) → خواندن اخبار → مشورت AI →
# انتخاب چند ارز + ارزهای اصلی → چک و تولید سیگنال (RuleSignalEngine)
# F1_DISCOVERY=1           # 0 = رفتار قدیمی (اسکن کامل استخر، رایگان)
# F1_MAIN_COINS=BTC,ETH,BNB,SOL,XRP   # ارزهای اصلی که همیشه چک می‌شوند
# F1_DISCOVERY_TOP_N=8     # سقف انتخاب غیرِاصلی
# F1_AI_SELECT_MIN_CONF=55 # حداقل اطمینان AI برای انتخاب نماد
# F1_AI_TTL_HOURS=4        # کش حکم AI (کنترل هزینه LLM)
# F1_NEWS_ENABLED=1
# F1_NEWS_MAX=10

# ---- کلید AI (اختیاری — بدون آن فال‌بک چندمنبعی استفاده می‌شود) ----
# هر سرویس سازگار با OpenAI-compatible؛ پیش‌فرض Z.ai GLM
# AI_API_KEY=your-key
# AI_API_BASE=https://api.z.ai/api/paas/v4
# AI_MODEL=glm-4.6
# CRYPTOPANIC_API_KEY=    # اختیاری: تیتر اخبار بیشتر برای پرامپت AI
# COINGECKO_API_KEY=      # اختیاری: سقف نرخ بالاتر CoinGecko
