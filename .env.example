# کپی کن به .env و مقادیر را پر کن
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_CHAT_ID=-1001234567890
# DRY_RUN=1 → پیام‌ها فقط در کنسول/لاگ (بدون ارسال واقعی). برای ارسال واقعی 0 بگذار
DRY_RUN=1
# (اختیاری) دایرکتوری داده جدا برای تست/شبیه‌سازی
# PS_DATA_DIR=/path/to/data

# ---- گاردهای پرتفویی W2 (اختیاری — پیش‌فرض‌ها توصیه‌شده) ----
# MAX_OPEN_TRADES=5        # سقف سراسری پوزیشن باز
# MAX_DAILY_LOSS_R=3.0     # مدار قطع روزانه بعد از -3R ضرر تجمعی
# PORTFOLIO_GUARDS=1       # 0 فقط برای شبیه‌سازی/پژوهش؛ در تولید همیشه 1

# ---- کشف ترند چندمنبعی بدون AI برای F1 (از v3.5.0) ----
# CoinGecko trending + مومنتوم/حجم KuCoin → top-N ∩ استخر ∪ ارزهای اصلی
# (+ تا F1_TREND_EXTRA_N ترند صرف CG خارج از استخر با جفت واقعی KuCoin)
# F1_DISCOVERY=1           # 0 = رفتار قدیمی (اسکن کامل استخر)
# F1_MAIN_COINS=BTC,ETH,BNB,SOL,XRP   # ارزهای اصلی که همیشه چک می‌شوند
# F1_DISCOVERY_TOP_N=8     # سقف انتخاب کاندیدا از داخل استخر
# F1_TREND_EXTRA_N=5       # سقف ترندهای صرف CoinGecko خارج از استخر (فقط F1)
# F1_DISCOVERY_TIMEOUT=8   # تایم‌اوت هر منبع (ثانیه)

# ---- لبه بایننس برای F1 (اختیاری؛ از v3.5.3) ----
# روی GitHub Actions پیش‌فرض 0 (HTTP 451 → فقط زمان/لاگ می‌سوزد)؛ محلی پیش‌فرض 1
# F1_BINANCE_MD=0          # 1 = depth/funding بایننس در رأی F1 لحاظ شود

# ---- کلیدهای اختیاری ----
# COINGECKO_API_KEY=       # اختیاری: سقف نرخ بالاتر CoinGecko
